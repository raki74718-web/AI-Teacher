{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-teacher",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "routes": [
    {
      "pattern": "aiteachers.in",
      "custom_domain": true
    }
  ]
}